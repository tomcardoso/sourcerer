{
  "manifest_version": 3,
  "name": "Sourcerer",
  "version": "1.0.0",
  "description": "Save a screenshot of the current tab to Sourcerer.",
  "browser_specific_settings": {
    "gecko": {
      "id": "sourcerer@sourcerer.app",
      "strict_min_version": "128.0"
    }
  },
  "permissions": ["tabs", "storage", "activeTab", "scripting", "contextMenus"],
  "host_permissions": ["http://127.0.0.1:27371/*"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to Sourcerer",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
